+def _hull(pts: list[tuple[float, float]]) -> list[tuple[float, float]]:
+    """The convex hull of page points, anticlockwise (Andrew's monotone chain); fewer than 3 corners when flat."""
+    pts = sorted(set(pts))
+    if len(pts) < 3:
+        return pts
+
+    def turn(o, a, b) -> float:
+        return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])
+
+    lower: list = []
+    upper: list = []
+    for p in pts:
+        while len(lower) >= 2 and turn(lower[-2], lower[-1], p) <= 0:
+            lower.pop()
+        lower.append(p)
+    for p in reversed(pts):
+        while len(upper) >= 2 and turn(upper[-2], upper[-1], p) <= 0:
+            upper.pop()
+        upper.append(p)
+    return lower[:-1] + upper[:-1]
+
+
+def _embedded_stems(items: list[_Item], contacts: dict[frozenset[str], int]) -> tuple[int, ...]:
+    """The stem items whose projected centre lies inside the convex hull of the elements touching them (plan 28 F3, M2:
+    8VBG's DNA hairpin, seen inside its protein, was pushed out to the page's edge by _attract, its contact pull losing
+    to the overlap penalty). Only a lone stem item with at least three touching elements counts."""
+    owner = _owner(items)
+    out = []
+    for k, it in enumerate(items):
+        if len(it.members) != 1 or not isinstance(it.members[0], PlacedStem):
+            continue
+        sid = it.members[0].id
+        pts = []
+        for pair in sorted(tuple(sorted(p)) for p in contacts if sid in p and len(p) == 2):
+            other = pair[0] if pair[1] == sid else pair[1]
+            if other in owner and not isinstance(owner[other][1], PlacedStem):
+                j, _, (ox, oy) = owner[other]
+                pts.append((float(_snap(items[j].cx + ox)), float(_snap(items[j].cy + oy))))
+        hull = _hull(pts)
+        if len(hull) >= 3:
+            x, y = it.cx, it.cy
+            edges = zip(hull, hull[1:] + hull[:1])
+            if all((b[0] - a[0]) * (y - a[1]) - (b[1] - a[1]) * (x - a[0]) > 0 for a, b in edges):
+                out.append(k)
+    return tuple(out)
+
+
+def _room_round(items: list[_Item], stems: tuple[int, ...]) -> None:
+    """Room made round each embedded stem (_embedded_stems) before _attract: every other item whose footprint, with
+    MARGIN, meets the stem's moves straight away from the stem's centre until clear, its home with it, in as many
+    passes as there are items (plan 28 F3: _attract alone pushed 8VBG's hairpin out of its protein)."""
+    for _ in range(len(items)):
+        moved = False
+        for k in stems:
+            s = items[k]
+            sx0, sy0, sx1, sy1 = (s.cx + s.box[0] - MARGIN, s.cy + s.box[1] - MARGIN, s.cx + s.box[2] + MARGIN,
+                                  s.cy + s.box[3] + MARGIN)  # fmt: skip
+            for j, it in enumerate(items):
+                if j in stems or it.pinned:
+                    continue
+                b = it.box
+                ox = min(sx1, it.cx + b[2]) - max(sx0, it.cx + b[0])
+                oy = min(sy1, it.cy + b[3]) - max(sy0, it.cy + b[1])
+                if ox <= 0 or oy <= 0:
+                    continue
+                v = np.array([it.cx - s.cx, it.cy - s.cy])
+                n = float(np.hypot(*v))
+                v = v / n if n > 1e-6 else np.array([0.0, -1.0])
+                step = min(ox / max(abs(v[0]), 1e-3), oy / max(abs(v[1]), 1e-3)) + 1.0 / _GRID  # a grid step past touching
+                it.cx, it.cy = float(_snap(it.cx + v[0] * step)), float(_snap(it.cy + v[1] * step))
+                it.home = (float(_snap(it.home[0] + v[0] * step)), float(_snap(it.home[1] + v[1] * step)))
+                moved = True
+        if not moved:
+            return
+
