+def test_embedded_stem_kept_inside(monkeypatch):
+    """Plan 28 F3 (M2): 8VBG's DNA hairpin is seen inside its protein (its centre inside the hull of the elements
+    touching it), and _attract, whose contact pull lost to the overlap penalty, pushed it and its protein out to the
+    page's edge (contact_auc 0.505, stems_nearer_frac 0.5). In a plain frame such a stem now gets room before _attract
+    and a stronger pull (layout._embedded_stems, _room_round): its touching elements are drawn nearer it than the
+    rest. A stem the protein holds from outside is no embedded stem (1IHF's bent DNA; 1ZAA's duplex across the page,
+    a RadialFrame, is never asked)."""
+    import foldmap.layout as L
+    from foldmap.nacheck import contacts as near
+
+    found: dict[str, list] = {}
+    real = L._embedded_stems
+
+    def spy(items, contacts):
+        got = real(items, contacts)
+        found.setdefault(name, []).extend(items[k].members[0].id for k in got)
+        return got
+
+    monkeypatch.setattr(L, "_embedded_stems", spy)
+    name = "8VBG"
+    lay, sses, bb = make_layout(Path(__file__).parent / "data" / "na_fixes" / "8VBG.cif.gz")
+    assert found["8VBG"], found
+    m = near(lay, sses)
+    assert m["contact_auc"] >= 0.6 and m["stems_nearer_frac"] == 1.0, m
+    for name, path in (("1IHF", NA / "1IHF.cif.gz"), ("1ZAA", Path(__file__).parent / "data" / "1ZAA.cif")):
+        make_layout(path)
+        assert not found.get(name), found
