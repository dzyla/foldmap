 def stem_pieces(na: Nucleic) -> list[Stem]:
-    """Every stem of the nucleic acid, long bent ones cut into straight pieces, in 5'->3' order."""
-    return [piece for st in na.structure.stems for piece in segment_stem(st, na.strands)]
+    """Every stem of the nucleic acid, long bent ones cut into straight pieces, in 5'->3' order; a stem the layout keeps
+    whole (Nucleic.whole, _kept_whole) as it is."""
+    whole = getattr(na, "whole", set())
+    return [piece for st in na.structure.stems for piece in ([st] if st.id in whole else segment_stem(st, na.strands))]
+
+
+WHOLE_BEND = 60.0  # degrees: a short duplex whose pieces turn less than this in 3D may be kept whole (_kept_whole)
+WHOLE_DRAWN = 90.0  # degrees: ... when its pieces would be drawn turned more than this (a right angle) on the page
+
+
+def _kept_whole(na: Nucleic, frame) -> set[str]:
+    """The stems drawn whole although segment_stem cuts them (plan 28 F5, M6): a duplex under 2 * SEGMENT_MIN pairs
+    whose pieces turn less than WHOLE_BEND degrees in 3D (nucleic.bend) but would be drawn turned more than WHOLE_DRAWN
+    degrees from one to the next, as `frame` sees their axes: projection, not the molecule, makes that fold. 6QIK's
+    10-bp A:410-419/y:4-13, cut into two 5-bp pieces turned 52 degrees in 3D and 111 on the page, was drawn with its
+    pieces pushed apart and its 0-nt joint y:8-9 with no route. Strongly kinked DNA keeps its pieces (1IHF over 160
+    degrees, 1YTB 80)."""
+    out = set()
+    for st in na.structure.stems:
+        if len(st) >= 2 * SEGMENT_MIN:
+            continue
+        parts = segment_stem(st, na.strands)
+        if len(parts) < 2 or bend(parts, na.strands) >= WHOLE_BEND:
+            continue
+        seen = [frame.direction(*stem_axis(p, na.strands)) for p in parts]
+        turns = [
+            math.degrees(math.acos(max(-1.0, min(1.0, float(a @ b) / max(float(np.hypot(*a) * np.hypot(*b)), 1e-12)))))
+            for a, b in zip(seen, seen[1:])
+        ]
+        if max(turns) > WHOLE_DRAWN:
+            out.add(st.id)
+    return out
 
 
