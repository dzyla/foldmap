# environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# generated figures and downloads
output/
data/raw_dl/

# local working notes and private reference material
.superpowers/
reference/

# development planning notes
docs/superpowers/

# website build output
_site/

# nucleic-acid validation campaign: contact sheets, figures and intermediate step reports stay local (regenerate with scripts/na_validate.py)
docs/validation/na/*.png
docs/validation/na/*.svg
docs/validation/na/report-step*
docs/validation/na/run-step*

# random-100 campaign: contact sheets, figures, page and step reports stay local (regenerate with scripts/random100.py)
docs/validation/random100/*.png
docs/validation/random100/*.svg
docs/validation/random100/*.html
docs/validation/random100/report-step*
docs/validation/random100/run-step*
# ... and each view's files and each entry's measures (report.json holds them all)
docs/validation/random100/work/
docs/validation/random100/*.json
!docs/validation/random100/sample.json
!docs/validation/random100/report.json
docs/validation/random100/*/report.json
# the held-out random-100 sample (final review A, Important 2): the same, report.json committed gzipped
docs/validation/random100-heldout/*.png
docs/validation/random100-heldout/*.svg
docs/validation/random100-heldout/*.html
docs/validation/random100-heldout/work/
docs/validation/random100-heldout/*.json
!docs/validation/random100-heldout/sample.json
